{
    "fontFamily": "Cascadia Mono",
    "fontSize": 17,
    "rowHeight": 22,
    "foreground": "#000",
    "background": "#FFFFFF",
    "selection": {
        "fill": "#800078D7"
    },
    "caret": {
        "width": 1,
        "stroke": "#000"
    },
    "addressMargin": {
        "text": {
            "foreground": "#7A7A7A"
        },
        "currentRow": {
            "foreground": "#000000"
        }
    },
    "outliningRegionHighlight": {
        "fill": "#EBEEF4"
    },
    "hexView": {
        "primaryGrouping": 4
    },
    "asciiView": {
    },
    "hyperlink": {
        "foreground": "#0000FF",
        "underline": true
    },
    "unnecessary": {
        "opacity": 0.5
    },
    "squigglesMap": {
        "error": {
            "stroke": "#FF0000"
        },
        "warning": {
            "stroke": "#008000"
        },
        "information": {
            "stroke": "#0000FF"
        }
    },
    "classificationMap": {
        "keyword": {
            "foreground": "#0000FF"
        }
    }
}